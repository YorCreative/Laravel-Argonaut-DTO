parameters:
    level: 8
    # $casts / $nestedAssemblers are declared by consumer subclasses as plain array
    # literals, so their PHPDoc shapes describe intent, not a runtime guarantee.
    # Keep them for inference without letting PHPStan call our defensive type
    # guards redundant.
    treatPhpDocTypesAsCertain: false
    paths:
        - src
    excludePaths:
        - vendor
    ignoreErrors:
        # Our toArray() method accepts an optional depth parameter, which extends the interface
        - '#Method Illuminate\\Contracts\\Support\\Arrayable.*::toArray\(\) invoked with 1 parameter, 0 required#'
        # Using new static() is a common Laravel pattern for DTOs
        - '#Unsafe usage of new static\(\)#'
